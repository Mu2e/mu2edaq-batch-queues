# {{ ansible_managed }}
# mc1-healthcheck status site (D26). httpd listens on {{ mc1_hc_web_listen }} (Listen in
# httpd.conf). "Require local" serves loopback clients only, i.e. ssh tunnels;
# the site firewall (50_FNAL) also rejects port 80 from the network.
ServerName {{ inventory_hostname }}
ServerTokens Prod
ServerSignature Off
DocumentRoot "{{ mc1_hc_web_dir }}"
<Directory "{{ mc1_hc_web_dir }}">
    Options -Indexes -FollowSymLinks
    AllowOverride None
    Require local
</Directory>
<FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
AddType application/json .json
