# {{ ansible_managed }}
# mc1-healthcheck status site (D26). httpd listens on {{ mc1_hc_web_listen }} (Listen in
# httpd.conf). Readers: loopback (ssh tunnels){{ ' and the cluster members below' if hc_web_allow | default([]) else '' }};
# several Require lines mean any of them. The firewall opens port 80 to the
# cluster members only (http in {{ mc1_fw_zone }} on this host); 50_FNAL rejects
# it for everyone else.
ServerName {{ inventory_hostname }}
ServerTokens Prod
ServerSignature Off
DocumentRoot "{{ mc1_hc_web_dir }}"
<Directory "{{ mc1_hc_web_dir }}">
    Options -Indexes -FollowSymLinks
    AllowOverride None
    Require local
{% if hc_web_allow | default([]) %}
    Require ip {{ hc_web_allow | join(' ') }}
{% endif %}
</Directory>
<FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
AddType application/json .json
