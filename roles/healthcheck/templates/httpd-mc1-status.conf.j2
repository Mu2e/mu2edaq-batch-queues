# {{ ansible_managed }}
# mc1-healthcheck status site (D26). httpd listens on {{ mc1_hc_web_listen }} (Listen in
# httpd.conf). httpd admits loopback (ssh tunnels) and the Require ip list below;
# several Require lines mean any of them. The firewall is the narrower gate:
# port 80 is open to the cluster members only (http in {{ mc1_fw_zone }} on this
# host), and 50_FNAL rejects it for every other address.
ServerName {{ inventory_hostname }}
ServerTokens Prod
ServerSignature Off
DocumentRoot "{{ mc1_hc_web_dir }}"
<Directory "{{ mc1_hc_web_dir }}">
    Options -Indexes -FollowSymLinks
    AllowOverride None
    Require local
{% set allow = (mc1_hc_web_allow_nets | default([])) + (hc_web_allow | default([])) %}
{% if allow %}
    Require ip {{ allow | unique | join(' ') }}
{% endif %}
</Directory>
<FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
</FilesMatch>
AddType application/json .json
