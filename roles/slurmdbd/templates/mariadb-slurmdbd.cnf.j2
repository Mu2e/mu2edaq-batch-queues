# {{ ansible_managed }}
# Settings recommended by SchedMD for slurmdbd (accounting.html). The server
# listens on loopback only; slurmdbd is the sole client.
[mysqld]
bind-address=127.0.0.1
innodb_buffer_pool_size={{ slurmdbd_innodb_buffer_pool_size }}
innodb_log_file_size=64M
innodb_lock_wait_timeout=900
max_allowed_packet=16M
