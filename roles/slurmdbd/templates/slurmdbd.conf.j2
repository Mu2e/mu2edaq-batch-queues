# {{ ansible_managed }}
# slurmdbd.conf for the Mu2e MC1 cluster ({{ slurm_cluster_name }}).
AuthType=auth/munge
DbdHost={{ slurm_controller_fqdn.split('.')[0] }}
DbdPort={{ slurm_ports.slurmdbd }}
SlurmUser=slurm
DebugLevel={{ slurm_debug }}
LogFile={{ slurm_log_dir }}/slurmdbd.log

StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser=slurm
StoragePass={{ slurmdbd_db_password }}
StorageLoc={{ slurmdbd_storage_loc }}

{% for key, value in slurmdbd_purge | dictsort %}
{{ key }}={{ value }}
{% endfor %}
