<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% block head %}{% endblock %}
<title>{% block title %}{{ web.title }}{% endblock %}</title>
<style>
/* Self-contained: the enclave has no CDN access, so no external CSS or JS. */
:root{
  --bg:#F5F7F8; --surface:#FFFFFF; --ink:#1B2329; --muted:#5B6873; --line:#D9E0E5; --soft:#E6EEF3;
  --accent:#2E6F8E;
  --ok:#2F8F5B; --ok-bg:#E4F3EA; --warn:#9A6610; --warn-bg:#FBF1DB;
  --fail:#C4443A; --fail-bg:#F9E3E1; --skip:#6F7C86; --skip-bg:#EDF0F2;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#12181D; --surface:#1A222A; --ink:#E6ECF0; --muted:#98A6B1; --line:#2C3740; --soft:#1F2C35;
  --accent:#6FB1D0;
  --ok:#5FC38A; --ok-bg:#1B3327; --warn:#E3AB45; --warn-bg:#3A2E14;
  --fail:#E5736A; --fail-bg:#3C1F1D; --skip:#8D9BA5; --skip-bg:#222B31;
  color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#12181D; --surface:#1A222A; --ink:#E6ECF0; --muted:#98A6B1; --line:#2C3740; --soft:#1F2C35;
  --accent:#6FB1D0;
  --ok:#5FC38A; --ok-bg:#1B3327; --warn:#E3AB45; --warn-bg:#3A2E14;
  --fail:#E5736A; --fail-bg:#3C1F1D; --skip:#8D9BA5; --skip-bg:#222B31;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--sans)}
.wrap{max-width:1100px;margin:0 auto;padding:20px 16px 48px}
nav{display:flex;flex-wrap:wrap;gap:4px 18px;align-items:baseline;border-bottom:2px solid var(--accent);padding-bottom:10px;margin-bottom:20px}
nav .brand{font-weight:600;font-size:17px;margin-right:auto}
nav a{color:var(--accent);text-decoration:none}
nav a[aria-current]{color:var(--ink);font-weight:600}
h1{font-size:22px;margin:0 0 6px} h2{font-size:17px;margin:28px 0 10px}
p{max-width:75ch;margin:0 0 10px}
code,.mono{font-family:var(--mono);font-size:13px}
a{color:var(--accent)}
.muted{color:var(--muted)}
.scroll{overflow-x:auto;background:var(--surface);border:1px solid var(--line)}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{padding:7px 10px;text-align:left;vertical-align:top;border-top:1px solid var(--line)}
th{background:var(--soft);font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:500;border-top:0;white-space:nowrap}
td.c,th.c{text-align:center}
.chip{display:inline-block;min-width:3.4em;text-align:center;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.ok{background:var(--ok-bg);color:var(--ok)} .warn{background:var(--warn-bg);color:var(--warn)}
.fail{background:var(--fail-bg);color:var(--fail)} .skip{background:var(--skip-bg);color:var(--skip)}
.banner{display:flex;flex-wrap:wrap;gap:8px 24px;align-items:center;padding:14px 18px;border:1px solid var(--line);background:var(--surface)}
.banner .big{font-size:20px;font-weight:700;padding:4px 14px;border-radius:6px;text-transform:uppercase}
.cell{display:inline-block;width:12px;height:22px;margin-right:2px;border-radius:2px}
.cell.ok{background:var(--ok)} .cell.warn{background:var(--warn)} .cell.fail{background:var(--fail)} .cell.skip{background:var(--skip)}
details summary{cursor:pointer;color:var(--muted);font-size:13px}
details ul{margin:4px 0 0;padding-left:18px;font-family:var(--mono);font-size:12.5px}
pre{background:var(--surface);border:1px solid var(--line);padding:10px 12px;overflow-x:auto;font:13px/1.45 var(--mono)}
footer{margin-top:36px;font-size:12.5px;color:var(--muted)}
@media (max-width:600px){ th,td{padding:6px} .hide-sm{display:none} }
</style>
</head>
<body>
<div class="wrap">
<nav aria-label="Site">
  <span class="brand">{{ web.title }}</span>
  {% for p, label in [("index.html","Status"),("history.html","History"),("api.html","API"),("about.html","About"),("sitemap.html","Sitemap")] %}
  <a href="{{ p }}"{% if p == page %} aria-current="page"{% endif %}>{{ label }}</a>
  {% endfor %}
</nav>
{% block body %}{% endblock %}
<footer>mc1-healthcheck {{ version }} · generated {{ status.generated }} on {{ status.host }} as {{ status.user }} · part of mu2edaq-batch-queues</footer>
</div>
</body>
</html>
