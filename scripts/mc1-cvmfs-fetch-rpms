#!/usr/bin/env python3
"""mc1-cvmfs-fetch-rpms - download the CernVM-FS client RPMs for EL9 and EL10
from the CERN yum repository into artifacts/rpms/cvmfs/<version>/{el9,el10}/,
verifying every file against the repository's sha256. The cvmfs role installs
from this bundle, so the MC1 nodes never need to reach cvmrepo themselves.

Override order: command line > environment (MC1_CVMFS_*) > built-in default.
Python 3.9 compatible; standard library only. See man/man1/mc1-cvmfs-fetch-rpms.1.
"""

import argparse
import gzip
import hashlib
import os
import sys
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NS = {"c": "http://linux.duke.edu/metadata/common",
      "repo": "http://linux.duke.edu/metadata/repo"}
DEFAULT_URL = "https://cvmrepo.s3.cern.ch/cvmrepo/yum/cvmfs/EL"
VERSIONED = ("cvmfs", "cvmfs-libs", "cvmfs-fuse3")   # pinned to --version
CONFIG_PKG = "cvmfs-config-default"                   # newest available


def fetch(url: str) -> bytes:
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read()


def vkey(pkg):
    v = pkg.find("c:version", NS).attrib
    return tuple(int(x) if x.isdigit() else x for x in (v["ver"] + "." + v["rel"]).replace("-", ".").split("."))


def select(base: str, el: str, version: str):
    """Return [(name, href, sha256)] for one EL major release."""
    repo = "%s/%s/x86_64" % (base, el)
    md = ET.fromstring(fetch(repo + "/repodata/repomd.xml"))
    prim = next(d for d in md.findall("repo:data", NS) if d.attrib["type"] == "primary")
    href = prim.find("repo:location", NS).attrib["href"]
    pkgs = ET.fromstring(gzip.decompress(fetch(repo + "/" + href))).findall("c:package", NS)
    out = []
    for name in VERSIONED + (CONFIG_PKG,):
        cands = [p for p in pkgs if p.find("c:name", NS).text == name
                 and p.find("c:arch", NS).text in ("x86_64", "noarch")]
        if name != CONFIG_PKG:
            cands = [p for p in cands if p.find("c:version", NS).attrib["ver"] == version]
        if not cands:
            raise SystemExit("EL%s: %s %s not in %s" % (el, name, version if name != CONFIG_PKG else "", repo))
        p = max(cands, key=vkey)
        cs = p.find("c:checksum", NS)
        if cs.attrib.get("type") != "sha256":
            raise SystemExit("EL%s: %s has a %s checksum, need sha256" % (el, name, cs.attrib.get("type")))
        out.append((name, repo + "/" + p.find("c:location", NS).attrib["href"], cs.text))
    return out


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-V", "--version", default=os.environ.get("MC1_CVMFS_VERSION", "2.14.1"),
                    help="cvmfs release (env MC1_CVMFS_VERSION, default %(default)s)")
    ap.add_argument("--el", default=os.environ.get("MC1_CVMFS_EL", "9,10"),
                    help="comma-separated EL majors (env MC1_CVMFS_EL, default %(default)s)")
    ap.add_argument("--url", default=os.environ.get("MC1_CVMFS_REPO_URL", DEFAULT_URL),
                    help="yum base above <el>/x86_64 (env MC1_CVMFS_REPO_URL)")
    ap.add_argument("-o", "--out", default=None,
                    help="output root (default artifacts/rpms/cvmfs/<version>)")
    ap.add_argument("-n", "--dry-run", action="store_true", help="list what would be fetched")
    a = ap.parse_args(argv)

    out = Path(a.out) if a.out else ROOT / "artifacts" / "rpms" / "cvmfs" / a.version
    for el in [e.strip() for e in a.el.split(",") if e.strip()]:
        dest = out / ("el" + el)
        for name, url, sha in select(a.url.rstrip("/"), el, a.version):
            f = dest / url.rsplit("/", 1)[1]
            if f.is_file() and hashlib.sha256(f.read_bytes()).hexdigest() == sha:
                print("ok      %s" % f.relative_to(out.parent))
                continue
            if a.dry_run:
                print("fetch   %s" % url)
                continue
            data = fetch(url)
            got = hashlib.sha256(data).hexdigest()
            if got != sha:
                raise SystemExit("%s: sha256 %s != repository %s" % (url, got, sha))
            dest.mkdir(parents=True, exist_ok=True)
            # Drop other builds of the same package so the role finds exactly one.
            for old in dest.glob(name + "-[0-9]*.rpm"):
                old.unlink()
            f.write_bytes(data)
            print("fetched %s" % f.relative_to(out.parent))
    return 0


if __name__ == "__main__":
    sys.exit(main())
